<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="capsule_edge_reveal">显示胶囊</string>
    <string name="capsule_edge_detail">拖动贴边后，空闲胶囊会缩成半圆并变淡。点按半圆恢复；需要你处理的事项保持完整显示。</string>
    <string name="capsule_hide_fullscreen">全屏时隐藏胶囊</string>
    <string name="capsule_hide_fullscreen_detail">前台应用铺满屏幕并隐藏状态栏时隐藏胶囊，退出全屏后恢复。任务和通知继续运行，默认关闭。</string>
    <string name="capsule_tile_setup">请打开 Mika，设置好手机操作后使用悬浮胶囊。</string>
    <string name="capsule_tile_add">添加到快捷设置</string>
    <string name="capsule_tile_manual">在安卓快捷设置中点「编辑」，添加「悬浮胶囊」即可快速开关，也可在 Mika 设置 › 悬浮胶囊里操作。</string>
    <string name="pip_size_smaller">缩小画面</string>
    <string name="pip_size_larger">放大画面</string>
    <string name="pip_size_reset">恢复默认大小</string>
</resources>
