<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="capsule_edge_reveal">顯示膠囊</string>
    <string name="capsule_edge_detail">拖曳貼邊後，閒置膠囊會縮成半圓並變淡。點按半圓恢復；需要你處理的事項保持完整顯示。</string>
    <string name="capsule_hide_fullscreen">全螢幕時隱藏膠囊</string>
    <string name="capsule_hide_fullscreen_detail">前景應用程式填滿螢幕並隱藏狀態列時隱藏膠囊，離開全螢幕後恢復。工作和通知繼續執行，預設關閉。</string>
    <string name="capsule_tile_setup">請開啟 Mika，設定好手機操作後使用浮動膠囊。</string>
    <string name="capsule_tile_add">加入快速設定</string>
    <string name="capsule_tile_manual">在 Android 快速設定中點「編輯」，加入「浮動膠囊」即可快速開關，也可在 Mika 設定 › 浮動膠囊中操作。</string>
    <string name="pip_size_smaller">縮小畫面</string>
    <string name="pip_size_larger">放大畫面</string>
    <string name="pip_size_reset">恢復預設大小</string>
</resources>
